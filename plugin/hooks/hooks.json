{
  "description": "Agentic-OS hard-law hooks (spec F7, F8).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/boundary/boundary_gate.py"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/production/production_gate.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
