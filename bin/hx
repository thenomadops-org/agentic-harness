#!/usr/bin/env python3
"""hx command dispatcher; subcommands are implemented in tools/ modules."""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tools"))


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(
            "usage: hx <command> [options]\n\n"
            "commands:\n  chat  read and post to team Slack"
            "\n  lock lead  record an owner-authorized lead holder"
            "\n  lead       read or hand off the current lead brief"
            "\n  done KEY   clean up a merged, Done ticket's panes, worktrees, databases"
            "\n  merge PR   gh pr merge, then hx done for the pull request's ticket"
            "\n  reap       report (or --close) what finished agents left behind"
        )
        return 0
    command, *args = argv
    if command == "chat":
        from hx_chat import main as chat_main

        return chat_main(args)
    if command == "lock":
        if not args or args[0] != "lead":
            print("hx lock: expected 'lead'", file=sys.stderr)
            return 2
        from hx_lead import lock_main

        return lock_main(args[1:])
    if command == "lead":
        from hx_lead import main as lead_main

        return lead_main(args)
    if command == "done":
        from hx_done import done_main

        return done_main(args)
    if command == "merge":
        from hx_done import merge_main

        return merge_main(args)
    if command == "reap":
        from hx_reap import main as reap_main

        return reap_main(args)
    print(f"hx: unknown command: {command}", file=sys.stderr)
    return 2


raise SystemExit(main(sys.argv[1:]))
